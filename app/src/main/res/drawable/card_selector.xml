<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="#2C4D71" />
            <stroke android:width="3dp" android:color="#9DD5FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="#304E6C" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="#1D2D40" />
            <stroke android:width="1dp" android:color="#2C4055" />
        </shape>
    </item>
</selector>
