<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="17dp"/>
            <solid android:color="#304D69"/>
            <stroke android:width="3dp" android:color="#B6E3FF"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="17dp"/>
            <solid android:color="#284562"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="17dp"/>
            <solid android:color="#1B2C3F"/>
            <stroke android:width="1dp" android:color="#32485E"/>
        </shape>
    </item>
</selector>
